// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Neon bağlantı URL'inizi buraya koyun
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  displayName String
  avatarUrl   String?
  googleId    String?
  bio         String?
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions Session[]
  posts    Post[]
  agahis   Agahi[]
  diroks   Dirok[]
  rojnames Rojname[]
  xanes    Xane[]
}

model Session {
  id        String    @id
  userId    String
  expiresAt DateTime?
  idleSince DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agahi {
  id          String   @id @default(cuid())
  content     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Media[]
}

model Dirok {
  id          String   @id @default(cuid())
  content     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Media[]
}

model Rojname {
  id          String   @id @default(cuid())
  content     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Media[]
}

model Xane {
  id          String   @id @default(cuid())
  content     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Media[]
}

model Media {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  agahiId   String?
  agahi     Agahi?   @relation(fields: [agahiId], references: [id])
  dirokId   String?
  dirok     Dirok?   @relation(fields: [dirokId], references: [id])
  rojnameId String?
  rojname   Rojname? @relation(fields: [rojnameId], references: [id])
  xaneId    String?
  xane      Xane?    @relation(fields: [xaneId], references: [id])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Mmmpeyam {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}
